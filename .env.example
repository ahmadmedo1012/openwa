# openwa-gateway environment template
# =============================================================================
# Copy to .env for local runs (docker run --env-file .env …). Placeholders
# ONLY — never commit real values. The complete variable table lives in
# README.md §Environment.
# =============================================================================

# REQUIRED — shared secret for every /api call (the sole API auth).
# openssl rand -hex 32
OPENWA_API_KEY=replace-with-32-plus-char-api-key

# RECOMMENDED — dedicated secret for encrypting persisted session
# credentials. Generate ONCE: only the FIRST rotation from the legacy
# API-key-derived key is transparent; generate again later and existing
# blobs fail both keys → every session must re-pair via QR.
# openssl rand -hex 32
OPENWA_CREDENTIALS_KEY=replace-with-32-plus-char-encryption-key

# Postgres connection string (sslmode enforced) — when set, session
# credentials are AES-256-GCM encrypted and persisted; restarts restore
# pairings without a new QR scan.
PERSISTENCE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Where Baileys credentials persist (default /data). Mount a volume here.
DATA_DIR=/data

# Listen port (default 2785).
PORT=2785

# pino log level (default info).
LOG_LEVEL=info

# OPTIONAL operator dashboard (disabled while unset). When both are set the
# cookie-authenticated dashboard is enabled at / .
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=replace-with-8-plus-chars
# DASHBOARD_SESSION_SECRET=replace-with-32-plus-chars

# OPTIONAL — forwarded-identity trust for rate limits + dashboard lockout.
# Default (unset) trusts the rightmost X-Forwarded-For entry — correct
# behind a reverse proxy. Set to 0 ONLY when the port is published directly
# with no proxy in front.
# TRUST_PROXY=0
